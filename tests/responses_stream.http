### OpenAI Responses API - Streaming Tests

# Variables
@baseUrl = http://localhost:3000
@token = your_api_token_here

### Test 1: Basic streaming response
# Enable both: RESPONSES_API_ENABLED=true RESPONSES_STREAM_ENABLED=true
POST {{baseUrl}}/v1/responses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "model": "gpt-4o",
  "input": "Count from 1 to 5",
  "stream": true
}

> {%
client.test("Streaming response received", function() {
  // Check that we got some SSE data
  client.assert(response.body.includes("event:"), "Should receive SSE events");
  client.assert(response.body.includes("response.created"), "Should receive response.created event");
});

client.test("Stream ends properly", function() {
  // Stream should end with response.done
  client.assert(response.body.includes("response.done"), "Should receive response.done event");
});
%}

### Test 2: Streaming with usage included
POST {{baseUrl}}/v1/responses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "model": "gpt-4o",
  "input": "What is the capital of France?",
  "stream": true,
  "stream_options": {
    "include_usage": true
  }
}

> {%
client.test("Stream includes usage", function() {
  client.assert(response.body.includes("response.done"), "Should receive response.done event");
});
%}

### Test 3: Streaming with instructions
POST {{baseUrl}}/v1/responses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "model": "gpt-4o",
  "input": "Name 3 colors",
  "instructions": "You are a helpful assistant that gives short answers",
  "stream": true
}

> {%
client.test("Streaming with instructions works", function() {
  client.assert(response.body.includes("response.created"), "Should receive response.created event");
});
%}

### Test 4: Tool call streaming
POST {{baseUrl}}/v1/responses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "model": "gpt-4o",
  "input": "What is the weather in Beijing?",
  "tools": [
    {
      "type": "function",
      "name": "get_weather",
      "description": "Get current weather for a city",
      "parameters": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string",
            "description": "The city name"
          }
        },
        "required": ["city"]
      }
    }
  ],
  "stream": true
}

> {%
client.test("Tool call streaming works", function() {
  client.assert(response.body.includes("response.created"), "Should receive response.created event");
  client.assert(response.body.includes("response.done"), "Should receive response.done event");
});

client.test("Tool call events present", function() {
  // Should have function_call events
  client.assert(
    response.body.includes("response.output_item.created") ||
    response.body.includes("response.function_call_arguments.delta"),
    "Should receive tool call events"
  );
});
%}

### Test 5: Stream can be terminated early (client disconnect simulation)
